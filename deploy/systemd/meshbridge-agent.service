[Unit]
Description=MeshBridge Agent
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/meshbridge-agent --controller https://mesh.example.com --device-id %i --token-file /etc/meshbridge/agent.token --allowed-roots /home/user/projects,/data
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true

[Install]
WantedBy=multi-user.target
