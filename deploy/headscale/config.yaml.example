# config.yaml.example for Headscale v0.29.4 — copy to /etc/headscale/config.yaml
# MUST validate with `headscale config check` before restart.
server_url: https://hs.example.com
listen_addr: 127.0.0.1:8080
metrics_listen_addr: 127.0.0.1:9090
noise:
  private_key_path: /var/lib/headscale/noise_private.key
prefixes:
  v4: 100.64.0.0/10
  v6: fd7a:115c:a1e0::/48
  allocation: sequential
derp:
  server:
    # CONTROL VPS MUST NOT relay normal big files: keep embedded DERP disabled.
    enabled: false
  urls: []
  paths: []
  auto_update_enabled: true
  update_frequency: 24h
database:
  type: sqlite
  sqlite:
    path: /var/lib/headscale/db.sqlite
    write_ahead_log: true
log:
  format: text
  level: info
dns:
  magic_dns: true
  base_domain: example.com
policy:
  path: /etc/headscale/policy.hujson
  mode: file
