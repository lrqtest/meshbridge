# config.yaml.example for Headscale v0.29.4 — copy to /etc/headscale/config.yaml
# MUST validate with `headscale configtest` before restart (0.29 renamed it from "config check").
server_url: https://hs.example.com
listen_addr: 127.0.0.1:8080
metrics_listen_addr: 127.0.0.1:9090
noise:
  private_key_path: /var/lib/headscale/noise_private.key
prefixes:
  v4: 100.64.0.0/10
  v6: fd7a:115c:a1e0::/48
  allocation: sequential
derp:
  server:
    # CONTROL VPS MUST NOT relay normal big files: keep embedded DERP disabled.
    enabled: false
  # Headscale 0.29 REFUSES to start with an empty DERP map. Since embedded DERP
  # is disabled, point paths at a placeholder map (or your own derper later).
  # NOTE: files under paths are YAML with lowercase keys (regions/regionid/...),
  # NOT the PascalCase JSON used by derp.urls. See deploy/headscale/derpmap.yaml.example.
  urls: []
  paths:
    - /etc/headscale/derpmap.yaml
  auto_update_enabled: false
  update_frequency: 24h
database:
  type: sqlite
  sqlite:
    path: /var/lib/headscale/db.sqlite
    write_ahead_log: true
log:
  format: text
  level: info
dns:
  magic_dns: true
  base_domain: example.com
policy:
  path: /etc/headscale/policy.hujson
  mode: file
