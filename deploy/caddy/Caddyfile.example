# Caddyfile.example — copy to /etc/caddy/Caddyfile, replace domains.
# Requires DNS A/AAAA for both domains -> VPS IP first (ACME).

hs.example.com {
	# Plain reverse_proxy per official Headscale recommendation (h2/websocket ok).
	reverse_proxy 127.0.0.1:8080
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
	}
}

mesh.example.com {
	reverse_proxy 127.0.0.1:8081
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}
}
